# GROQ_API_KEY is required to run benchmarks against the real Groq API.
# Get a free key from https://console.groq.com/
# Never commit this file with a real key.
GROQ_API_KEY=

# Primary and Fallback Groq models
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Failover Configuration
AI_PRIMARY_PROVIDER=gemini
AI_BACKUP_PROVIDER=groq
AI_FAILOVER_ENABLED=true
AI_SHARED_DEADLINE_MS=12000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_S=30.0
