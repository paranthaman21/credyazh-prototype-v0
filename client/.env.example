# Client environment variables
# For local development with Vite proxy to localhost:4000, leave empty or use /api
# For production deployment (e.g. Render/Vercel), point to your deployed Express server URL:
# VITE_API_URL=https://credyazh-server.onrender.com/api
VITE_API_URL=/api

# Yazh Guided Tour feature flag
# Set to 'false' to completely disable the tour overlay.
VITE_YAZH_TOUR_ENABLED=true
